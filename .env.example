# PasteBoard / PasteDeck — environment variables.
# Set these in Netlify: Site configuration -> Environment variables. Never commit real values.
# For local work, copy to .env and run `netlify dev`.

# --- Core -------------------------------------------------------------
PASTEBOARD_BASE_URL=https://pastedeck.netlify.app
# 32+ random characters. Signs session tokens. REQUIRED in production (functions refuse to run without it).
#   generate: openssl rand -base64 48
PASTEBOARD_SECRET=
# Protects the founder admin page and /admin-migrate (X-Admin-Token header). 24+ random characters.
PASTEBOARD_ADMIN_TOKEN=
# Only if you add another site origin (e.g. a custom domain), comma separated.
PASTEBOARD_EXTRA_ORIGINS=

# --- Payments (Creem) — see docs/payment-setup.md ----------------------
PAYMENT_PROVIDER=creem
CREEM_MODE=test                      # test | live   (anything but "live" = test)
CREEM_API_KEY=
CREEM_PREMIUM_PRODUCT_ID=            # product: $25 USD, one-time
CREEM_EXTRA_SEAT_PRODUCT_ID=         # product: $2.50 USD, one-time, quantity enabled
CREEM_WEBHOOK_SECRET=

# --- Email (Resend) — password reset, verification, invitations ---------
RESEND_API_KEY=
EMAIL_FROM="PasteBoard <no-reply@yourdomain.com>"   # domain must be verified in Resend (SPF + DKIM)

# --- Founder-only demo bootstrap (optional; remove after use) -----------
FOUNDER_BOOTSTRAP_EMAIL=
FOUNDER_BOOTSTRAP_SECRET=            # 16+ random characters
FOUNDER_DEMO_SEED=false              # true adds clearly-marked synthetic data to YOUR account only
